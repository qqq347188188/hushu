<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>DebFixer</string>
    <key>CFBundleDisplayName</key>
    <string>DebFixer</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>UILaunchScreen</key>
    <dict/>
    <!-- 让本 App 出现在「文件」App 分享 / 打开方式 中（与局域网互传一致） -->
    <key>UIFileSharingEnabled</key>
    <true/>
    <!-- 自定义 .deb UTI（导入声明，便于系统按扩展名识别） -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.example.debfixer.deb</string>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>deb</string>
                </array>
            </dict>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
                <string>public.archive</string>
            </array>
            <key>UTTypeDescription</key>
            <string>Debian Package</string>
        </dict>
    </array>
    <!--
      文档类型（Open In / “用…打开” / “打开方式”）：
      认领 public.data / public.content 以及 .deb 专属 UTI，
      使本程序像局域网互传一样出现在 .deb 的「打开方式」列表中。
      系统会把文件直接放进 App 沙盒 Documents/Inbox，无需 App Group，
      TrollStore / 自签下可用，主程序用 onOpenURL 读取并修复。
    -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Debian Package</string>
            <key>CFBundleTypeRole</key>
            <string>Editor</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.example.debfixer.deb</string>
                <string>public.data</string>
                <string>public.content</string>
            </array>
        </dict>
    </array>
    <!-- 供「共享扩展」跳回主程序（本仓库暂未接入扩展；保留以便将来启用） -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.example.debfixer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>debfixer</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
